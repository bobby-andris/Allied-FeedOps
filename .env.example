# .env.example
# LLM Providers (at least one required)
OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here

# =============================================================================
# DATA SOURCES (priority order: DB cache → Shopify → GMC → CSV fallback)
# =============================================================================

# Shopify API (primary source)
SHOPIFY_STORE_URL=yourstore.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Merchant Center (enrichment)
GMC_MERCHANT_ID=123456789
GMC_API_KEY=/path/to/service-account.json

# CSV Fallback (used when APIs unavailable)
CATALOG_PATH=data/catalog/Product Catalog.csv

# =============================================================================
# DATABASE & CACHING
# =============================================================================

# SQLite database for caching API responses
DATABASE_PATH=data/feedops.db

# Cache time-to-live (hours)
CACHE_TTL_HOURS=24

# Auto-sync before optimization (yes/no)
AUTO_SYNC_ENABLED=yes

# Optimization defaults
FEEDOPS_NUM_CANDIDATES=3
FEEDOPS_CANDIDATE_WEIGHTS=google=0.7,bing=0.15,shopify=0.15
