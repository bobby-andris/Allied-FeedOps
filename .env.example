# Allied FeedOps environment template
# IMPORTANT: Never store real credentials in this file.
# Copy this to .env.local (or your deploy provider env settings) and provide real values there.

# SUPABASE (REQUIRED)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GOOGLE ADS (OPTIONAL - required for Ads integrations)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# GOOGLE CLOUD (OPTIONAL)
GOOGLE_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Base64-encoded service account JSON
GOOGLE_SERVICE_ACCOUNT_KEY=

# SHOPIFY (OPTIONAL)
SHOPIFY_STORE_URL=
SHOPIFY_API_KEY=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_SECRET=

# GOOGLE MERCHANT CENTER (OPTIONAL)
GMC_API_KEY=
GMC_MERCHANT_ID=

# GOOGLE SHEETS (OPTIONAL)
GOOGLE_SHEETS_SPREADSHEET_ID=

# LLM PROVIDERS (REQUIRED for generation)
OPENAI_API_KEY=
GEMINI_API_KEY=

# SECURITY
CRON_SECRET=

# OPENAI COST/USAGE RECONCILIATION (OPTIONAL but recommended)
OPENAI_USAGE_API_KEY=
OPENAI_ORG_ID=
# OPENAI_PROJECT_ID is optional project-level filter for reconciliation
OPENAI_PROJECT_ID=
