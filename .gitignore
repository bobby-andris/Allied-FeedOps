# Local data (do not commit)
data/
creds/
.playwright/

# Environment files (never commit secrets)
.env
.env.*
!.env.example
.env.local
.env.development
.env.production

# Samples directory may contain anonymized examples (allowed)
# But raw data exports should stay gitignored
!samples/

# API credentials and tokens
*.pem
*.key
credentials.json
token.json
service-account*.json

# Reports and exports (generated, potentially contain PII)
reports/
exports/
# But allow dashboard_data reports (curated for demo)
!dashboard_data/lifestyle-eval/reports/
.worktrees/

# Node/TypeScript
node_modules/
dist/
*.tsbuildinfo

# Python
__pycache__/
*.pyc
.venv/
venv/

# IDE
.vscode/
*.swp
*.swo
.DS_Store
RUN_EVAL_BATCH_INSTRUCTIONS.md
CURSOR_PROMPT_IMAGE_IMPROVEMENTS.md
CODE_REVIEW_RESULTS.md
LIFESTYLE_IMAGES_CONTEXT.md
