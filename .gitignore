# Local data (do not commit most data files)
data/*
# But allow finish metadata files (needed for Streamlit Cloud)
!data/finishes.txt
!data/finish-metadata.json
creds/
.playwright/
.playwright-mcp/

# Streamlit secrets (never commit)
.streamlit/secrets.toml

# Environment files (never commit secrets)
.env
.env.*
!.env.example
.env.local
.env.development
.env.production

# Samples directory may contain anonymized examples (allowed)
!samples/

# API credentials and tokens
*.pem
*.key
credentials.json
token.json
service-account*.json
feedops-auth.json

# Reports, exports, and evaluation data (generated, potentially contain PII)
reports/
exports/
dashboard_data/

# Worktrees
.worktrees/

# Node/TypeScript
node_modules/
dist/
*.tsbuildinfo

# Next.js (dashboard/)
dashboard/.next/
dashboard/out/
dashboard/.vercel

# Python
__pycache__/
*.pyc
.venv/
.venv
venv/

# IDE
.vscode/
.cursor/
*.swp
*.swo
.DS_Store

# Stale top-level docs (removed from repo)
CURSOR_PROMPT_IMAGE_IMPROVEMENTS.md
CODE_REVIEW_RESULTS.md
RUN_EVAL_BATCH_INSTRUCTIONS.md
LIFESTYLE_IMAGES_CONTEXT.md

# Supabase temp files
supabase/.temp/

# Test output artifacts
test_output/

# Git bundle files (backup artifacts)
*.bundle
backups/

# MCP config (local)
.mcp.json

# macOS system directories
Library/

# iCloud/Finder duplicate files (files with " 2" suffix)
*\ 2.png
*\ 2.md
*\ 2.sql
*\ 2.log

# Agent skills (installed locally, not tracked)
.agent/
.agents/skills/
# .claude/skills/ — tracked in git so Cloud Build can copy to Cloud Run container
.cursor/skills/

# Claude checkpoints (session-specific, not tracked)
.claude/checkpoints/

# npm artifacts
.npm/

# GSD planning artifacts (local-only state files)
.planning/debug/
.planning/v1.1-MILESTONE-AUDIT.md
.planning/STATE.md.bak-*

# Archived planning directories
.planning-archive-*/

# Log files
logs/
