# Local data (do not commit most data files)
data/*
# But allow finish metadata files (needed for Streamlit Cloud)
!data/finishes.txt
!data/finish-metadata.json
creds/
.playwright/
.playwright-mcp/

# Streamlit secrets (never commit)
.streamlit/secrets.toml

# Environment files (never commit secrets)
.env
.env.*
!.env.example
.env.local
.env.development
.env.production

# Samples directory may contain anonymized examples (allowed)
# But raw data exports should stay gitignored
!samples/

# API credentials and tokens
*.pem
*.key
credentials.json
token.json
service-account*.json

# Reports and exports (generated, potentially contain PII)
reports/
exports/
# But allow dashboard_data reports (curated for demo)
!dashboard_data/lifestyle-eval/reports/
!dashboard_data/lifestyle-eval-candidate/reports/
.worktrees/

# Node/TypeScript
node_modules/
dist/
*.tsbuildinfo

# Next.js (dashboard/)
dashboard/.next/
dashboard/out/
dashboard/.vercel

# Python
__pycache__/
*.pyc
.venv/
.venv
venv/

# IDE
.vscode/
*.swp
*.swo
.DS_Store
RUN_EVAL_BATCH_INSTRUCTIONS.md
CURSOR_PROMPT_IMAGE_IMPROVEMENTS.md
CODE_REVIEW_RESULTS.md
LIFESTYLE_IMAGES_CONTEXT.md
dashboard_data/lifestyle-eval-candidate/reports/pilot-selection-report-detailed.html
dashboard_data/lifestyle-eval-candidate/reports/pilot-selection-report-detailed.pdf

# Supabase temp files
supabase/.temp/

# Test output artifacts
test_output/

# Git bundle files (backup artifacts, not stored in repo)
*.bundle
.mcp.json

# macOS system directories (accidentally created in repo root)
Library/

# iCloud/Finder duplicate files (files with " 2" suffix)
*\ 2.png
*\ 2.md
*\ 2.sql
*\ 2.log

# Agent skills (installed locally, not tracked)
.agent/skills/
.agents/skills/
# .claude/skills/ — tracked in git so Cloud Build can copy to Cloud Run container
.cursor/skills/

# Claude checkpoints (session-specific, not tracked)
.claude/checkpoints/

# npm artifacts
.npm/

# GSD planning artifacts (local-only)
.planning/config.json
.planning/debug/
.planning/v1.1-MILESTONE-AUDIT.md
.planning/STATE.md.bak-2026-02-23T18-10-45
