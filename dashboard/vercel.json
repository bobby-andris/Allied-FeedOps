{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "git": {
    "deploymentEnabled": {
      "master": true,
      "codex/*": false
    }
  },
  "crons": [
    {
      "path": "/api/ga4/snapshot-capture",
      "schedule": "15 8 * * *"
    },
    {
      "path": "/api/monitoring/cost-reconciliation",
      "schedule": "45 8 * * *"
    }
  ]
}
